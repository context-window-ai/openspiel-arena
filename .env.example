# =============================================================================
# openspiel-arena — environment variables
# Copy this file to .env and fill in real values.  Never commit .env.
# =============================================================================

# --- LLM API keys -----------------------------------------------------------
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# --- Arena settings ----------------------------------------------------------
# Directory where match result JSON files are written.
ARENA_RESULTS_DIR=results/

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
ARENA_LOG_LEVEL=INFO

# --- Optional: LLM model overrides ------------------------------------------
# Defaults are set in agents/llm_agent.py; override here if needed.
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_MODEL=claude-opus-4-5

# --- Optional: parallelism ---------------------------------------------------
# Number of matches to run concurrently (default 1 = sequential).
# ARENA_MAX_WORKERS=4
